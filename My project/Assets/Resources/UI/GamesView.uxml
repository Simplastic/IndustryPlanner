<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:ip="IndustryPlanner.UI" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Styles/Theme.uss" />
    <ui:Style src="project://database/Assets/UI/Styles/HomeScreen.uss" />
    <ui:VisualElement class="main">
        <ui:VisualElement class="header">
            <ui:VisualElement class="header__titles">
                <ui:Label text="Games" class="header__title t-bold" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="canvas">
            <ip:DotGridBackground picking-mode="Ignore" class="dot-grid" />
            <ui:ScrollView name="gameGrid" mode="Vertical" horizontal-scroller-visibility="Hidden" class="card-grid" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

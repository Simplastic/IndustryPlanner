/* ---------- Editor frame ---------- */

.editor {
    flex-grow: 1;
}

.editor-bar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 12px;
    background-color: var(--panel);
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.editor-bar__name {
    width: 340px;
    margin-left: 12px;
}

.app .editor-bar__name > .unity-base-text-field__input {
    font-size: 20px;
    background-color: transparent;
    border-color: transparent;
    -unity-font-definition: url("project://database/Assets/Art/Fonts/Rajdhani/Rajdhani-Bold%20SDF.asset");
}

.app .editor-bar__name:hover > .unity-base-text-field__input {
    border-color: var(--line);
}

.editor-bar__game {
    margin-left: 8px;
    color: var(--text-muted);
}

.editor-bar__spacer {
    flex-grow: 1;
}

.editor-bar__state {
    margin-right: 12px;
    color: var(--text-muted);
}

.app .editor-bar__tier {
    margin-left: 12px;
    height: 30px;
    font-size: 14px;
}

.app .editor-bar__snap {
    margin-right: 8px;
}

.app .editor-bar__panel {
    margin-left: 8px;
}

.editor-body {
    flex-grow: 1;
    flex-direction: row;
}

.canvas-host {
    flex-grow: 1;
    overflow: hidden;
}

/* ---------- Canvas ---------- */

.graph-canvas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: var(--bg);
}

.graph-content {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
}

.link-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    --link-color: #7A858F;
    --link-starved-color: #D9A441;
    --link-fluid-color: #5FA8D3;
    --link-selected-color: #FFC266;
    --link-overloaded-color: #F06258;
}

/* Right-drag box selection. */
.marquee {
    position: absolute;
    background-color: rgba(255, 141, 0, 0.08);
    border-width: 1px;
    border-color: var(--accent);
}

.placement-ghost {
    position: absolute;
    padding: 4px 10px;
    background-color: var(--surface-raised);
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 4px;
    font-size: 14px;
}

/* ---------- Nodes (same language as the home cards) ---------- */

.node {
    position: absolute;
    width: 290px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-top-width: 3px;
    border-top-color: var(--accent);
    border-radius: 4px;
}

/* Listed properties only: left/top must follow the mouse instantly while dragging. */
.node {
    transition-property: opacity, scale, border-color;
    transition-duration: 160ms;
    transition-timing-function: ease-out-cubic;
}

.node:hover {
    border-color: var(--line-strong);
}

.node--selected,
.node--selected:hover {
    border-color: var(--accent);
}

/* Placement and removal. */
.node--enter {
    opacity: 0;
    scale: 0.92 0.92;
}

.node--exit {
    opacity: 0;
    scale: 0.92 0.92;
}

/* Uses something above the production's tier. */
.node--locked {
    opacity: 0.55;
}

.node--underfed {
    border-top-color: var(--danger);
}

.node__header {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    background-color: var(--surface-raised);
}

.node__titles {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
}

.node__title {
    font-size: 17px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.node__subtitle {
    font-size: 13px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.node__badge {
    margin-left: 8px;
    font-size: 16px;
    color: var(--accent);
}

.node__ports {
    flex-direction: row;
    padding: 10px 14px;
}

.nport-column {
    flex-grow: 1;
    flex-basis: 0;
}

.nport-column--out {
    margin-left: 12px;
    align-items: flex-end;
}

.nport {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    height: 24px;
}

.nport--out {
    justify-content: flex-end;
}

.nport__item {
    flex-shrink: 1;
    margin-left: 6px;
    font-size: 14px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.nport__rate {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 14px;
}

.nport--out > .nport__rate {
    color: var(--accent);
}

.nport__rate--short {
    color: var(--danger);
}

/* Pin handle on the node edge: 14px padding + 1px border + half of 12px. */
.nport__dot {
    position: absolute;
    top: 6px;
    width: 12px;
    height: 12px;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--line-strong);
    background-color: var(--surface);
}

.nport--in > .nport__dot {
    left: -21px;
}

.nport--out > .nport__dot {
    right: -21px;
    border-color: var(--accent);
}

.nport__dot--linked {
    background-color: var(--line-strong);
}

.nport--out > .nport__dot--linked {
    background-color: var(--accent);
}

.nport__dot--fluid {
    border-color: var(--fluid);
}

.nport__dot {
    transition-duration: 120ms;
}

.nport__dot:hover {
    border-color: var(--text);
    scale: 1.3 1.3;
}

/* Both ends of a link are filled, so a connected input is as visible as its output. */
.nport--in > .nport__dot--linked {
    background-color: var(--accent);
    border-color: var(--accent);
}

.nport__dot--linked.nport__dot--fluid {
    background-color: var(--fluid);
    border-color: var(--fluid);
}

/* While dragging a link: dim pins that can't take it, ring the ones that can. */
.graph-content--linking .nport__dot {
    opacity: 0.3;
}

.graph-content--linking .nport__dot--candidate,
.graph-content--linking .nport__dot--source {
    opacity: 1;
    border-color: var(--accent);
    scale: 1.25 1.25;
}

.graph-content--linking .nport__dot--target {
    background-color: var(--accent);
    scale: 1.6 1.6;
}

.node__footer {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.node__power {
    font-size: 14px;
    color: var(--text-muted);
}

.node__prod {
    flex-grow: 1;
    font-size: 14px;
    color: var(--text-muted);
    -unity-text-align: middle-right;
    opacity: 0;
    transition-duration: 150ms;
}

.node__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background-color: var(--line);
    opacity: 0;
    transition-duration: 150ms;
}

.node__bar-fill {
    height: 100%;
    background-color: var(--accent);
    transition-duration: 300ms;
}

/* Productivity shows when the node is hovered or selected, and always when it's starved. */
.node:hover .node__prod,
.node--selected .node__prod,
.node--underfed .node__prod,
.node:hover .node__bar,
.node--selected .node__bar,
.node--underfed .node__bar {
    opacity: 1;
}

.node--underfed .node__prod {
    color: var(--danger);
}

.node--underfed .node__bar-fill {
    background-color: var(--danger);
}

.node--logistics .node__bar {
    display: none;
}

/* ---------- Hotbar (Shapez 2 style) ---------- */

.hotbar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 16px;
    align-items: center;
}

.hotbar__hint {
    margin-bottom: 8px;
    padding: 4px 12px;
    background-color: var(--panel);
    border-radius: 4px;
    font-size: 14px;
    color: var(--text-muted);
}

.hotbar__variants {
    flex-direction: row;
    margin-bottom: 8px;
}

.app .variant {
    transition-duration: 150ms;
    transition-timing-function: ease-out-cubic;
    margin: 0 3px;
    height: 30px;
    padding: 0 12px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
    color: var(--text-muted);
    font-size: 15px;
}

.app .variant--enter {
    opacity: 0;
    translate: 0 6px;
}

.app .variant--active {
    border-color: var(--accent);
    color: var(--text);
}

.hotbar__slots {
    flex-direction: row;
    padding: 6px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
}

.app .hotbar-slot {
    transition-duration: 120ms;
    transition-timing-function: ease-out-back;
    margin: 0 3px;
    width: 88px;
    height: 74px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 4px;
}

.app .hotbar-slot:hover {
    background-color: var(--surface);
}

.app .hotbar-slot--active {
    background-color: var(--surface);
    border-color: var(--accent);
    translate: 0 -4px;
}

.app .hotbar-slot--locked {
    opacity: 0.35;
}

.app .hotbar-slot--pulse {
    scale: 1.08 1.08;
}

.hotbar-slot__key {
    position: absolute;
    top: 3px;
    left: 6px;
    font-size: 13px;
    color: var(--text-faint);
}

.hotbar-slot--active > .hotbar-slot__key {
    color: var(--accent);
}

.hotbar-slot__label {
    margin-top: 6px;
    font-size: 13px;
    color: var(--text-muted);
}

.hotbar-slot--active > .hotbar-slot__label {
    color: var(--text);
}

/* ---------- Picker ---------- */

.picker-layer {
    transition-duration: 150ms;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    padding-top: 72px;
    background-color: rgba(0, 0, 0, 0.45);
}

.picker-layer--enter {
    opacity: 0;
}

.picker {
    transition-duration: 180ms;
    transition-timing-function: ease-out-cubic;
    width: 540px;
    height: 70%;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 6px;
}

.picker-layer--enter > .picker {
    translate: 0 -12px;
}

.picker__title {
    padding: 14px 16px 6px 16px;
    font-size: 19px;
}

.picker__search {
    margin: 4px 16px 10px 16px;
}

.picker__list {
    flex-grow: 1;
}

.picker__list .unity-collection-view__item--selected {
    background-color: var(--surface-raised);
}

.picker-row {
    flex-direction: row;
    align-items: center;
    height: 50px;
    padding: 0 16px;
}

.picker-row__texts {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
}

.picker-row__title {
    font-size: 16px;
}

.picker-row__subtitle {
    font-size: 13px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.picker-row__tag {
    margin-left: 8px;
    padding: 1px 6px;
    border-width: 1px;
    border-color: var(--accent);
    border-radius: 3px;
    font-size: 12px;
    color: var(--accent);
}

/* ---------- Side panel ---------- */

.side-panel {
    flex-shrink: 0;
    width: 340px;
    overflow: hidden;
    transition-duration: 200ms;
    transition-timing-function: ease-out-cubic;
    background-color: var(--panel);
    border-left-width: 1px;
    border-left-color: var(--line);
}

.side-panel--collapsed {
    width: 0;
    border-left-width: 0;
}

.side-panel__tabs {
    flex-direction: row;
    padding: 8px 12px 0 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.app .tab {
    margin: 0 4px 0 0;
    height: 36px;
    padding: 0 14px;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-radius: 0;
    color: var(--text-muted);
    font-size: 16px;
}

.app .tab:hover {
    color: var(--text);
}

.app .tab--active {
    border-bottom-color: var(--accent);
    color: var(--text);
}

.side-panel__body {
    flex-grow: 1;
}

.side-panel__body .unity-scroll-view__content-container {
    padding: 16px;
}

.panel-section {
    margin-bottom: 20px;
}

.panel-title {
    font-size: 21px;
    white-space: normal;
}

.panel-subtitle {
    color: var(--text-muted);
}

.panel-heading {
    margin-bottom: 8px;
    font-size: 14px;
    color: var(--text-muted);
}

.panel-hint {
    color: var(--text-muted);
    white-space: normal;
}

.field-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.field-row__label {
    width: 96px;
    color: var(--text-muted);
}

.field-row__field {
    flex-grow: 1;
}

.app .field-row__button {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: flex-start;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.panel-actions {
    flex-direction: row;
}

.panel-actions {
    flex-wrap: wrap;
}

.segmented--wrap {
    flex-wrap: wrap;
}

.app .panel-actions > .btn {
    margin: 0 8px 8px 0;
}

.app .panel-wide {
    margin-top: 12px;
}

/* Clock presets: own full-width row; five equal buttons. */
.clock-presets {
    margin: 0 0 8px 0;
}

.app .clock-presets > .segment {
    flex-basis: 0;
    min-width: 0;
    padding: 0;
    margin: 0 4px 0 0;
    font-size: 13px;
}

.nport__item--any {
    color: var(--text-faint);
}

.field-row__hint {
    margin: -2px 0 8px 96px;
}

/* Blueprint list */
.blueprint-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.blueprint-row__texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.blueprint-row__meta {
    font-size: 13px;
    color: var(--text-muted);
    white-space: normal;
}

.app .blueprint-row__more {
    width: 32px;
    height: 32px;
    margin-left: 6px;
}

.stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.stat {
    width: 50%;
    margin-bottom: 12px;
}

.stat__label {
    font-size: 14px;
    color: var(--text-muted);
}

.stat__value {
    font-size: 22px;
}

.stat__value--warn {
    color: var(--danger);
}

.data-row {
    flex-direction: row;
    align-items: center;
    height: 26px;
}

.data-row--clickable:hover {
    background-color: var(--surface);
}

.data-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.data-row__value {
    width: 58px;
    -unity-text-align: middle-right;
    color: var(--text-muted);
}

.data-row__value--neg {
    color: var(--danger);
}

.data-row__value--pos {
    color: var(--accent);
}

.data-row--header > .data-row__value,
.data-row--header > .data-row__name {
    font-size: 13px;
    color: var(--text-faint);
}

.data-row__value--auto {
    width: auto;
    margin-left: 8px;
}

/* A whole production line used as a node: thicker accent band so it reads as a bigger block. */
.node--production {
    border-top-width: 6px;
    width: 330px;
}

/* Settings > Reduce motion. Kept last so it wins over every transition above. */
.app.reduce-motion * {
    transition-duration: 0s;
}
